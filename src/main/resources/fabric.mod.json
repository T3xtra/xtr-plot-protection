{
	"schemaVersion": 1,
	"id": "xtr_build_protection",
	"version": "${version}",
	"name": "xtr_build_protection",
	"description": "This standalone mod allows you to precisely configure blocks and areas, that are protected from destruction in certain ways.",
	"authors": [
		"Textra"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/T3xtra/xtr_build_protection"
	},
	"license": "MIT",
	"icon": "assets/xtr_build_protection/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xtr.buildprot.XtrBuildProtection"
		],
		"client": [
			"xtr.buildprot.XtrBuildProtectionClient"
		]
	},
	"mixins": [
		"xtr_build_protection.mixins.json",
		{
			"config": "xtr_build_protection.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.23",
		"minecraft": "~1.20.2",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}